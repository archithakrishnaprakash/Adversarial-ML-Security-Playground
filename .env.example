# Copy to .env and fill in for your actual deployment, then:
#   docker compose up --build -d

# The URL a user's BROWSER can reach the backend at. For a local test,
# http://localhost:8000 is correct. For a real deployment, this needs to be
# your server's public IP/domain and port, e.g. http://203.0.113.10:8000 or
# https://api.yourdomain.com if you've put a reverse proxy + TLS in front.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated list of origins allowed to call the API from a browser.
# For a real deployment, set this to your frontend's actual URL, e.g.
# https://yourdomain.com — do not leave this as * once it's public.
ALLOWED_ORIGINS=http://localhost:3000
